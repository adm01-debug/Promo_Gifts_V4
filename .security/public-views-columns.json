      "sensitive_acknowledged": {
        "ncm_code": {
          "pattern": "ncm",
          "status": "REQUER-PO",
          "note": "Classificação fiscal NCM/Mercosul do produto (varchar(10)), exposta sem máscara ao anon. Não é custo unitário nem preço negociado; é um código de tarifa aduaneira frequentemente público em notas fiscais/e-commerce BR. Achado E16 (2026-09-16) — decisão de mascarar ou manter é do PO, ver docs/E16_VIEWS_PUBLIC_SECDEF_2026-09-16.md."
        },
        "ncm_id": {
          "pattern": "ncm",
          "status": "REQUER-PO",
          "note": "FK (uuid) para a tabela interna de classificação NCM. Mesma decisão de ncm_code — hoje exposto sem máscara. Achado E16 (2026-09-16)."
        },
        "bitrix_product_id": {
          "pattern": "bitrix",
          "status": "REQUER-PO",
          "note": "ID interno (integer) de correlação com o CRM Bitrix, exposto sem máscara ao anon — diferente de bitrix_images_synced_at, já mascarado como NULL nesta view. Revela superfície de integração interna; risco de enumeração/correlação, não de vazamento de preço/PII direto. Achado E16 (2026-09-16), P1 até decisão do PO — não corrigido nesta etapa (regra do plano: [RO]/investigação aqui, correção é [REQUER-PO] em etapa separada)."
        }
      }
