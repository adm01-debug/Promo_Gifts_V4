{
  "$comment": "Contrato de colunas das 8 views SECURITY DEFINER expostas ao anon (catálogo público). Snapshot pg_catalog de 2026-09-05 (auditoria r3). Toda mudança nestas views exige atualizar este arquivo no mesmo PR; `node scripts/check-public-views-columns.mjs --live <json>` compara com o banco.",
  "query": "select c.relname, array_agg(a.attname order by a.attnum) as columns from pg_class c join pg_namespace n on n.oid=c.relnamespace join pg_attribute a on a.attrelid=c.oid and a.attnum>0 and not a.attisdropped where n.nspname='public' and c.relkind='v' and c.relname = any($1) group by 1 order by 1",
  "views": {
    "v_kit_component_media_public": {
      "columns": ["kit_component_id", "kit_product_id", "component_product_id", "component_code", "component_name", "primary_image_url", "images", "display_order"],
      "forbidden": []
    },
    "v_product_compositions_public": {
