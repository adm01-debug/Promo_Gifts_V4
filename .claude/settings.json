{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "G=$(command -v graphify || echo \"$HOME/.local/bin/graphify\"); [ -x \"$G\" ] && exec \"$G\" hook-guard search; exit 0"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "G=$(command -v graphify || echo \"$HOME/.local/bin/graphify\"); [ -x \"$G\" ] && exec \"$G\" hook-guard read; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
