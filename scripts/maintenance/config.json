{
  "version": 1,
  "manager": "npm",
  "tsconfigs": ["tsconfig.app.json"],
  "gates": [
    {
      "name": "lint",
      "command": ["npm", "run", "lint:baseline"]
    },
    {
      "name": "types",
      "command": ["node", "scripts/maintenance/typecheck.mjs", "tsconfig.app.json"]
    },
    {
      "name": "test",
      "command": ["node", "node_modules/vitest/vitest.mjs", "run", "--maxWorkers=1"]
    },
    {
      "name": "build",
      "command": ["npm", "run", "build"]
    }
  ],
  "fix": {
    "roots": ["src"],
    "eslintRules": [],
    "prettier": true,
    "exclude": ["src/integrations/supabase/types.ts"]
  },
  "timeoutMs": 300000,
  "maxFiles": 20,
  "maxChangedLines": 400
}
