// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProposalFreightVolumes — snapshot estável > renderiza a tabela Caixa × Quantidade e os totais 1`] = `"<div style="margin-top:14px"><div style="font-family:&#x27;Montserrat&#x27;, sans-serif;font-weight:700;font-size:12px;color:#00c853;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;padding-left:2px">Volumes estimados para transporte</div><div style="border:1px solid #e0e0e0;border-radius:8px;padding:12px 16px;background-color:#fafafa"><table style="width:100%;border-collapse:collapse;margin-bottom:8px"><thead><tr><th style="text-align:left;font-size:9px;font-weight:700;color:#888;text-transform:uppercase;padding:0 8px 4px 0">Caixa</th><th style="text-align:right;font-size:9px;font-weight:700;color:#888;text-transform:uppercase;padding:0 0 4px 8px">Quantidade</th></tr></thead><tbody><tr style="border-bottom:1px solid #eee"><td style="font-size:10px;color:#333;font-weight:600;padding:4px 8px 4px 0">Caixa P</td><td style="font-size:10px;color:#333;font-weight:600;text-align:right;padding:4px 0 4px 8px">3</td></tr></tbody></table><div style="font-size:10px;color:#333;font-weight:600;display:flex;justify-content:space-between;border-top:2px solid #e8f5e9;padding-top:6px"><span>Peso total: 0,32 kg</span><span>Volume total: 0,03 m³</span></div><p style="font-size:8.5px;color:#999;font-style:italic;margin:6px 0 0 0;line-height:1.4">Estimativa baseada nas caixas padrão da empresa.</p></div></div>"`;
